declare const Netlify: { env: { get(name: string): string | undefined } };

function reply(request: Request, status: number, payload: Record<string, unknown>) {
  const headers = { 'Cache-Control': 'no-store' };
  if (request.headers.get('accept')?.includes('application/json')) {
    return Response.json(payload, { status, headers });
  }
  if (status === 200 && payload.ok && !payload.pending) {
    return new Response(null, { status: 303, headers: { ...headers, Location: '/thank-you?type=newsletter' } });
  }
  return new Response(String(payload.message || 'Please try again later.'), { status, headers: { ...headers, 'Content-Type': 'text/plain; charset=utf-8' } });
}

export default async function subscribe(request: Request) {
  if (request.method !== 'POST') return new Response('Method not allowed', { status: 405, headers: { Allow: 'POST' } });
  const origin = request.headers.get('origin');
  if (origin && origin !== new URL(request.url).origin) return reply(request, 403, { ok: false, message: 'Please subscribe through our website.' });
  if (!request.headers.get('content-type')?.startsWith('application/x-www-form-urlencoded')) return reply(request, 415, { ok: false, message: 'Please use the signup form.' });
  if (Number(request.headers.get('content-length') || 0) > 8192) return reply(request, 413, { ok: false, message: 'The form is too large.' });
  const reader = request.body?.getReader();
  let length = 0;
  const chunks: Uint8Array[] = [];
  if (reader) {
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      length += value.byteLength;
      if (length > 8192) { await reader.cancel(); return reply(request, 413, { ok: false, message: 'The form is too large.' }); }
      chunks.push(value);
    }
  }
  const bytes = new Uint8Array(length);
  let offset = 0;
  for (const chunk of chunks) { bytes.set(chunk, offset); offset += chunk.length; }
  const data = new URLSearchParams(new TextDecoder().decode(bytes));
  if (data.get('company')) return reply(request, 400, { ok: false, message: 'Unable to process this request.' });
  const name = (data.get('name') || '').trim(), email = (data.get('email') || '').trim();
  const language = data.get('language'), source = data.get('source');
  if (!name || name.length > 80 || /[<>\r\n]/.test(name) || email.length > 254 || !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(email) || !['english', 'hinglish'].includes(language || '') || !['newsletter', 'check'].includes(source || '') || data.get('consent_version') !== '2026-09-18') {
    return reply(request, 400, { ok: false, message: 'Please check your name, email address, and language preference.' });
  }
  const token = Netlify.env.get('MAILERLITE_API_KEY');
  const group = Netlify.env.get(language === 'hinglish' ? 'MAILERLITE_GROUP_HINGLISH' : 'MAILERLITE_GROUP_ENGLISH');
  if (!token || !group) return reply(request, 503, { ok: false, message: 'Newsletter signup is not open just yet. Please try again soon. All the free tools are available now.' });
  try {
    const response = await fetch('https://connect.mailerlite.com/api/subscribers', {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ email, fields: { name, cf_language: language, cf_source: source, cf_consent_version: '2026-09-18', cf_consent_at: new Date().toISOString() }, groups: [group] }),
      signal: AbortSignal.timeout(10000)
    });
    if (!response.ok) return reply(request, 502, { ok: false, message: 'We could not complete your signup. Please try again later. You can still use the free tools.' });
    const value = await response.json();
    const state = value.data?.status;
    if (state === 'unconfirmed') return reply(request, 200, { ok: true, pending: true, message: 'Please check your inbox for a confirmation email. Follow its link to finish subscribing.' });
    if (state !== 'active') return reply(request, 409, { ok: false, message: 'This address could not be subscribed. Please contact mail@capitalandfreedom.com if you would like help.' });
    return reply(request, 200, { ok: true, message: 'Thank you for subscribing.' });
  } catch {
    return reply(request, 502, { ok: false, message: 'We could not confirm your signup. Please try again in a moment.' });
  }
}
export const config = { path: '/api/subscribe' };
